# Copy to .env (gitignored). `docker compose up` works without a .env except for the LLM key.
# Values below target the dockerized emulators from the host (`pnpm dev`).
# Inside compose, service hostnames are set in compose.yaml and override these.

# --- LLM ---------------------------------------------------------------------------------------
# Any Mastra model router id. Default: Gemini Flash-Lite on the Google AI Studio free tier.
# LLM_MODEL=demo: a scripted model, no key (browser e2e tests, UI work without spending quota).
# Prefer the macOS Keychain over this file (scripts/env-from-keychain.sh); on a host, use its secrets.
LLM_MODEL=google/gemini-3.5-flash-lite
GOOGLE_GENERATIVE_AI_API_KEY=
# Only when LLM_MODEL=anthropic/claude-haiku-4-5 (paid)
ANTHROPIC_API_KEY=

# --- Demo limits (web; defaults suit a public demo on the Gemini free tier, see docs/deploy.md) ----
# Agent turns: per user per day, and in total per minute and per day.
LLM_TURNS_PER_USER_PER_DAY=40
LLM_TURNS_PER_MINUTE=4
LLM_TURNS_PER_DAY=150
# Rate limiting: /api/chat per user per minute; logins per IP and failed logins per e-mail, per 15 min.
CHAT_REQUESTS_PER_MINUTE=10
LOGIN_ATTEMPTS_PER_IP=20
LOGIN_FAILURES_PER_EMAIL=5

# --- MongoDB -----------------------------------------------------------------------------------
# directConnection: from the host, the replica set member is advertised as localhost:27017
MONGODB_URI=mongodb://localhost:27017/?directConnection=true
# Replica set member address used by the init step (compose sets mongo:27017)
MONGO_REPLICA_HOST=localhost:27017
TICKETS_DB=tickets
ASSIST_DB=assist

# --- AWS (local emulators accept any credentials; never put real keys here) -------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# Cognito: Floci locally (one container for Cognito and SQS). On AWS, leave the endpoint empty and set the pool/client ids.
COGNITO_ENDPOINT=http://localhost:4566
COGNITO_USER_POOL_NAME=nexo-assist
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Floci signs `iss` with its FLOCI_BASE_URL (compose.yaml sets http://localhost:4566)
COGNITO_ISSUER_DOMAIN=http://localhost:4566
COGNITO_JWKS_DOMAIN=http://localhost:4566

# SQS: Floci locally. On AWS, leave the endpoint empty.
SQS_ENDPOINT=http://localhost:4566
# Queue names (defaults shown; on AWS they match the queues created by infra/)
SQS_TICKET_WRITES_QUEUE=ticket-writes
SQS_ASSIST_EVENTS_QUEUE=assist-events
SQS_HANDOFF_EVENTS_QUEUE=handoff-events

# --- Services ----------------------------------------------------------------------------------
# Tickets service port (not PORT: .env also reaches the web container)
TICKETS_PORT=4000
TICKETS_URL=http://localhost:4000
# Password for every seeded user (demo only; see README)
SEED_PASSWORD=nexo123

# --- Simulated legacy flakiness (tickets service) ---------------------------------------------
FLAKY_ENABLED=true
FLAKY_MEAN_INTERVAL_S=120
FLAKY_MIN_MS=3000
FLAKY_MAX_MS=8000
# Local only: POST /_chaos/outage?ms=30000 forces an outage to demo the queue fallback.
# Always off with APP_ENV=production, whatever this says.
CHAOS_ENABLED=true

# --- Production only (set on the hosting platform, never here; see docs/deploy.md) ---------------
# APP_ENV=production   # refuse to start with missing secrets or emulator endpoints
# MANAGED_INFRA=true   # init against Atlas + Terraform-managed Cognito/SQS: only users and seed
