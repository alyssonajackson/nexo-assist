{
  "name": "nexo-assist",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @nexo/tickets --filter @nexo/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "pnpm --filter @nexo/tests test:integration",
    "smoke": "./scripts/smoke.sh",
    "init:local": "pnpm --filter @nexo/scripts init:local",
    "seed:reset": "pnpm --filter @nexo/scripts seed:reset",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "secrets:scan": "./scripts/scan-secrets.sh",
    "token": "pnpm --filter @nexo/scripts -s token"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
